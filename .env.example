# Copy to .env in the repository root and replace the password placeholder.
FINSIGHT_ENVIRONMENT=development
# JSON array; only these browser origins receive CORS permission.
FINSIGHT_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Local PostgreSQL in Docker; port 5432 may already be used on the host.
FINSIGHT_DB_HOST=localhost
FINSIGHT_DB_PORT=5433
FINSIGHT_DB_NAME=finsight
FINSIGHT_DB_USER=finsight
FINSIGHT_DB_PASSWORD=replace-with-a-long-random-local-password
# Backend connection/pool timeouts in seconds; SQL statement timeout in milliseconds.
FINSIGHT_DB_CONNECT_TIMEOUT=3
FINSIGHT_DB_POOL_TIMEOUT=3
FINSIGHT_DB_STATEMENT_TIMEOUT_MS=3000

# Registration safeguards per API process; production needs shared/edge limits.
FINSIGHT_REGISTRATION_BODY_BYTES=16384
FINSIGHT_REGISTRATION_REQUESTS_PER_MINUTE=5
FINSIGHT_REGISTRATION_CLIENT_CAPACITY=4096
FINSIGHT_REGISTRATION_CONCURRENT_HASHES=2
