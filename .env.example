# Copy to .env in the repository root and replace the password placeholder.
FINSIGHT_ENVIRONMENT=development
# JSON array; only these browser origins receive CORS permission.
FINSIGHT_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Local PostgreSQL in Docker; port 5432 may already be used on the host.
FINSIGHT_DB_HOST=localhost
FINSIGHT_DB_PORT=5433
FINSIGHT_DB_NAME=finsight
FINSIGHT_DB_USER=finsight
FINSIGHT_DB_PASSWORD=replace-with-a-long-random-local-password
# Backend connection/pool timeouts in seconds; SQL statement timeout in milliseconds.
FINSIGHT_DB_CONNECT_TIMEOUT=3
FINSIGHT_DB_POOL_TIMEOUT=3
FINSIGHT_DB_STATEMENT_TIMEOUT_MS=3000

# Registration safeguards per API process; production needs shared/edge limits.
FINSIGHT_REGISTRATION_BODY_BYTES=16384
FINSIGHT_REGISTRATION_REQUESTS_PER_MINUTE=5
FINSIGHT_REGISTRATION_CLIENT_CAPACITY=4096
FINSIGHT_REGISTRATION_CONCURRENT_HASHES=2

# Internal access JWT primitives; login/cookies are not implemented yet.
FINSIGHT_JWT_ISSUER=finsight-api
FINSIGHT_JWT_AUDIENCE=finsight-web
FINSIGHT_JWT_ACCESS_TTL_SECONDS=900
# Configure a randomly generated 32-byte key as 64 hex characters only when needed.
# Keep it local/secret. This deliberately unusable example remains commented out.
# FINSIGHT_JWT_SIGNING_KEY=<64-hex-characters-generated-locally>

# Internal session/cookie/CSRF helpers; HTTP authentication routes are not wired yet.
FINSIGHT_AUTH_REFRESH_TTL_SECONDS=604800
FINSIGHT_AUTH_CSRF_TTL_SECONDS=900
# Explicit exception for development/test on loopback only; production requires true/HTTPS.
FINSIGHT_AUTH_COOKIE_SECURE=false
FINSIGHT_AUTH_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8000","http://127.0.0.1:8000"]
# Generate separately from the JWT key; never reuse either key for the other purpose.
# FINSIGHT_AUTH_CSRF_SIGNING_KEY=<different-64-hex-characters-generated-locally>
FINSIGHT_AUTH_LOGIN_REQUESTS_PER_MINUTE=5
FINSIGHT_AUTH_PASSWORD_CHANGE_REQUESTS_PER_MINUTE=5
FINSIGHT_AUTH_REQUESTS_PER_MINUTE=60
FINSIGHT_AUTH_CLIENT_CAPACITY=4096
FINSIGHT_AUTH_LOGIN_BODY_BYTES=16384
FINSIGHT_AUTH_BODY_BYTES=1024
